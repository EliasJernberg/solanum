using Gtk 4.0;
using Adw 1;

template $SolanumPreferencesWindow : Adw.PreferencesWindow {
  search-enabled: false;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("Session Length");
      description: _("The length of each session type in minutes. Changes apply to the next session of each type.");

      Adw.SpinRow lap_spin {
        title: _("Lap Length");
        numeric: true;
        adjustment: Gtk.Adjustment adjustment {
          lower: 1;
          upper: 99;
          step-increment: 1;
        };
      }

      Adw.SpinRow short_break_spin {
        title: _("Short Break Length");
        numeric: true;
        adjustment: Gtk.Adjustment {
          lower: bind adjustment.lower;
          upper: bind adjustment.upper;
          step-increment: bind adjustment.step-increment;
        };
      }

      Adw.SpinRow long_break_spin {
        title: _("Long Break Length");
        numeric: true;
        adjustment: Gtk.Adjustment {
          lower: bind adjustment.lower;
          upper: bind adjustment.upper;
          step-increment: bind adjustment.step-increment;
        };
      }
    }

    Adw.PreferencesGroup {
      Adw.SpinRow session_count_spin {
        title: _("Sessions Until Long Break");
        numeric: true;
        adjustment: Gtk.Adjustment {
          lower: bind adjustment.lower;
          upper: bind adjustment.upper;
          step-increment: bind adjustment.step-increment;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Daily Goal");
      description: _("Completed laps are counted per day and shown under the timer.");

      Adw.SpinRow daily_goal_spin {
        title: _("Laps per Day");
        numeric: true;
        adjustment: Gtk.Adjustment {
          lower: bind adjustment.lower;
          upper: bind adjustment.upper;
          step-increment: bind adjustment.step-increment;
        };
      }
    }

    Adw.PreferencesGroup {
      Adw.SwitchRow fullscreen_switch {
        title: _("Fullscreen During Breaks");
      }
    }

    Adw.PreferencesGroup {
      title: _("Rain Background");

      Adw.SwitchRow rain_switch {
        title: _("Show Rain Background");
      }

      Adw.ActionRow rain_image_row {
        title: _("Background Image");
        use-markup: false;
        sensitive: bind rain_switch.active;

        [suffix]
        Gtk.Button rain_image_choose_button {
          label: _("Choose…");
          valign: center;
        }

        [suffix]
        Gtk.Button rain_image_reset_button {
          label: _("Reset");
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Rain Sound");

      Adw.SwitchRow rain_sound_switch {
        title: _("Rain Sound Audible");
      }

      Adw.ActionRow rain_sound_file_row {
        title: _("Sound File");
        use-markup: false;

        [suffix]
        Gtk.Button rain_sound_choose_button {
          label: _("Choose…");
          valign: center;
        }

        [suffix]
        Gtk.Button rain_sound_reset_button {
          label: _("Reset");
          valign: center;
        }
      }

      Adw.SpinRow rain_volume_spin {
        title: _("Volume (%)");
        numeric: true;
        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 100;
          step-increment: 5;
          page-increment: 10;
        };
      }
    }
  }
}
