using Gtk 4.0;
using Adw 1;

template $SolanumWindow : Adw.ApplicationWindow {
  default-width: 360;
  default-height: 360;
  height-request: 294;
  default-widget: timer_button;
  content: Adw.ToolbarView {
    extend-content-to-top-edge: true;
    top-bar-style: flat;

    [top]
    Adw.HeaderBar {
      show-title: false;
      show-start-title-buttons: false;
      show-end-title-buttons: false;
    }

    content: Gtk.Overlay {
      // The rain background (a WebKit view) is added here at runtime.
      child: Gtk.Box rain_box {
        hexpand: true;
        vexpand: true;
      };

      [overlay]
      Gtk.Box {
        orientation: vertical;
        valign: center;
        vexpand: true;
        styles ["main-box"]

        Gtk.Label lap_label {
          styles ["lap-label"]
        }

        Gtk.Label timer_label {
          styles ["timer-label", "blinking"]
        }

        // The count of the day, with buttons to step it by hand that show
        // when the pointer is over it.
        Gtk.Box today_box {
          halign: center;
          spacing: 6;
          styles ["today-row"]

          Gtk.Button today_back_button {
            tooltip-text: _("Count Lap Back");
            icon-name: "list-remove-symbolic";
            action-name: "win.lap-back";
            valign: center;
            styles ["flat", "circular", "today-adjust"]
          }

          Gtk.Label today_label {
            styles ["today-label"]
          }

          Gtk.Button today_forward_button {
            tooltip-text: _("Count Lap Forward");
            icon-name: "list-add-symbolic";
            action-name: "win.lap-forward";
            valign: center;
            styles ["flat", "circular", "today-adjust"]
          }
        }

        Gtk.CenterBox controls {
          halign: center;
          styles ["controls"]

          [center]
          Gtk.Box {
            spacing: 14;
            halign: center;

            Gtk.Button timer_button {
              tooltip-text: _("Toggle Timer");
              icon-name: "media-playback-start-symbolic";
              action-name: "win.toggle-timer";
              valign: center;
              styles ["circular", "large", "primary-control", "suggested-action"]
            }

            Gtk.Button skip_button {
              tooltip-text: _("Skip");
              icon-name: "media-seek-forward-symbolic";
              action-name: "win.skip";
              valign: center;
              styles ["circular", "large"]
            }

            Gtk.ToggleButton sound_button {
              tooltip-text: _("Rain Sound");
              icon-name: "audio-volume-muted-symbolic";
              valign: center;
              styles ["circular", "large"]
            }
          }

          [end]
          Gtk.MenuButton menu_button {
            primary: true;
            tooltip-text: _("Main Menu");
            menu-model: app_menu;
            icon-name: "open-menu-symbolic";
            halign: end;
            valign: center;
            margin-start: 14;
            styles ["circular", "menu-control"]
          }
        }
      }
    };
  };

  Adw.Breakpoint large_text_bp {
    condition ("min-width: 800sp and min-height: 800sp")
  }

  // A window that fills a monitor gets a clock to match.
  Adw.Breakpoint huge_text_bp {
    condition ("min-width: 1600sp and min-height: 1000sp")
  }
}

menu app_menu {
  section {
    item (_("Reset Sessions"), "win.reset")
  }

  section {
    item (_("Count Lap Forward"), "win.lap-forward")
    item (_("Count Lap Back"), "win.lap-back")
    item (_("Reset Today's Count"), "win.reset-today")
  }

  section {
    item (_("Next Background"), "win.next-background")
    item (_("Previous Background"), "win.previous-background")
  }

  section {
    item (_("_Preferences"), "app.preferences")
    item (_("_Keyboard Shortcuts"), "win.show-help-overlay")
    item (_("_About Solanum"), "app.about")
  }
}
